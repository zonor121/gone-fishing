# Основное хранилище. sqlite — только для локальных проверок старой БД.
DB_BACKEND=supabase
SUPABASE_URL=https://your-project.supabase.co
# Серверный Secret key из Settings → API Keys. Не publishable/anon!
SUPABASE_SECRET_KEY=
# Для старых проектов вместо Secret key поддерживается SUPABASE_SERVICE_ROLE_KEY.
PORT=8000
